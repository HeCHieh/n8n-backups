              "name": "content",
              "type": "string",
              "value": "={{ (() => {\n        const r = $json;\n        const b = r.body ?? r;\n        const status = Number(r.statusCode);\n        if (status === 409 && b.code === 'attendance_already_claimed') return '今天已签到，无需重复领取。';\n        if (status >= 200 && status < 300 && b.success !== false && !r.error) {\n          return ['签到成功！', b.attendance_date != null ? '签到日期：' + b.attendance_date : '', b.total_reward != null ? '本次获得：' + b.total_reward + ' 积分' : '本次积分：接口未返回', b.base_reward != null ? '基础奖励：' + b.base_reward + ' 积分' : '', b.streak_reward != null ? '连续签到奖励：' + b.streak_reward + ' 积分' : '', b.experience_reward != null ? '获得经验：' + b.experience_reward : '', b.current_streak != null ? '连续签到：' + b.current_streak + ' 天' : ''].filter(Boolean).join(String.fromCharCode(10));\n        }\n        const step = $prevNode.name === '认证失效' ? '签到' : $prevNode.name;\n        const reason = b.code || r.error?.code || 'request_failed';\n        const detail = b.detail || b.message || (typeof r.error === 'string' ? r.error : r.error?.message) || r.message || '接口未返回错误说明';\n        return ['签到失败！', '失败步骤：' + step, Number.isFinite(status) ? 'HTTP 状态：' + status : '', '错误代码：' + reason, '错误说明：' + String(detail).slice(0, 500)].filter(Boolean).join(String.fromCharCode(10));\n      })() }}"
