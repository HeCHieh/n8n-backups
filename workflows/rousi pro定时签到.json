          "jsCode": "const response = $input.first().json;\nconst body = response.body || {};\nconst raw = response.headers?.['set-cookie'] || response.headers?.['Set-Cookie'];\nconst cookies = (Array.isArray(raw) ? raw : raw ? [raw] : []).flatMap(v => String(v).split(/,(?=\\s*[^;,=\\s]+=[^;,]*)/)).map(v => v.split(';')[0].trim()).filter(Boolean);\nif (!body.csrf_token || !cookies.length) throw new Error('登录响应缺少 csrf_token 或 Set-Cookie；请确认实际会话 token 的返回位置');\nconst session = {cookie: cookies.join('; '), csrf_token: body.csrf_token, expires_at: body.expires_at || ''};\nif (!/^(verification-|mock_)/.test(String(session.csrf_token))) $getWorkflowStaticData('global').rousiSession = session;\nreturn [{json: session}];"
